# --- Local dev ---
# When set, Flask also serves the frontend/ folder itself (same origin as the
# API), which sidesteps browser cross-site cookie rules entirely for local
# testing. Leave unset in production — GH Pages serves the frontend there.
LOCAL_DEV=1

# --- Database ---
# Local dev: leave as-is, uses backend/db/local.db
# Production (Turso): set both of these from `turso db show <name>` / `turso db tokens create <name>`
DB_URL=file:db/local.db
DB_AUTH_TOKEN=

# --- Flask ---
SECRET_KEY=change-this-to-a-random-string
FRONTEND_URL=http://127.0.0.1:5000

# --- Lecturer account creation ---
# Required to create a new lecturer account. Only share this with
# lecturers/admins — never put it on a page students can reach.
# Registration is closed (not open) if this is unset.
SYSTEM_KEY=change-this-to-a-shared-secret
